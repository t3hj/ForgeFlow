{
  "name": "forgeflow",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered software engineering and repository intelligence platform",
  "scripts": {
    "dev": "vite apps/web --config apps/web/vite.config.ts --host 0.0.0.0",
    "dev:api": "node --experimental-strip-types apps/api/src/server.ts",
    "build": "npm run build --prefix apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "ioredis": "^5.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
